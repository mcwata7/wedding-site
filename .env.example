POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=planner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: override the API base URL used by the internal UI dev server.
# In Docker Compose the UI proxies /api → api:8080, so this is only needed for
# non-Docker development against a remote backend.
INTERNAL_UI_API_BASE_URL=
# Same, but for the public wedding site's dev server.
PUBLIC_UI_API_BASE_URL=
# Where the API stores uploaded wedding-site images. In Docker Compose this is a named
# volume mount; for bare-metal `bootRun` it defaults to backend/data/media.
WEDDING_MEDIA_DIR=
# The guest-facing public site's origin, used to build the full QR payload printed on
# invitation cards ({PUBLIC_SITE_URL}/i/{token}). Defaults to the Docker Compose web-public
# port; set this to your real domain before printing cards for mailing.
PUBLIC_SITE_URL=
# Slack incoming-webhook URL that receives one message per party RSVP (Yes/No roster for the
# event they just responded to). Leave blank to disable the integration -- it silently no-ops
# without one. Keep the real value out of version control.
SLACK_WEB_HOOK=
# Comma-separated frontend origins allowed to call the API cross-origin. Leave blank for local
# dev/Docker Compose, where the frontends are same-origin with the API via the nginx proxy.
# Needed when frontend and API are on different origins -- in production this is the guest and
# planner Firebase Hosting origins (both the .web.app AND .firebaseapp.com aliases -- Firebase
# serves every site on both, and they're distinct origins). See deploy/ and SYSTEM_DESIGN.md §10.
WEDDING_CORS_ALLOWED_ORIGINS=
# --- Production (GCP VM + Firebase Hosting) only -- see deploy/ and SYSTEM_DESIGN.md §10 ---
# The API's public hostname: a static GCP external IP resolved through sslip.io, e.g.
# api.34-1-2-3.sslip.io (no custom domain owned -- see docs/DECISIONS.md).
API_HOSTNAME=
# Email Let's Encrypt uses for expiry/problem notices about the API's TLS cert.
ACME_EMAIL=
# Full Artifact Registry image ref + tag for the backend, built by .github/workflows/deploy.yml,
# e.g. us-west1-docker.pkg.dev/<project>/wedding/api:<sha>. Not needed for local Compose.
API_IMAGE=
# GCS bucket name (no gs:// prefix) that deploy/backup.sh dumps nightly Postgres + media backups
# into, e.g. <project>-wedding-backups.
BACKUP_BUCKET=
# --- `make deploy*` (manual/local deploy via the Makefile) only -- mirrors the GCP_REGION/
# GCP_ZONE/GCP_VM_NAME repo Variables .github/workflows/deploy.yml uses in CI. Not needed for
# local Compose or for CI (GitHub Actions reads its own copies from repo Variables). ---
# Region the VM and Artifact Registry were created in, e.g. us-west1 (must match GCP_ZONE).
GCP_REGION=
# Zone the VM was created in, e.g. us-west1-b.
GCP_ZONE=
# Name of the GCP Compute Engine VM instance, e.g. wedding-vm.
GCP_VM_NAME=
